# === Global / OS ===
# Ignore operating system files
.DS_Store
Thumbs.db
desktop.ini

# === Local Environments / API Keys ===
# VERY IMPORTANT! Ignore all environment variables and secrets.
*.env
.env
.env.local
.env.*.local
# But DO include example files!
!*.env.example

# === IDEs ===
# Ignore IDE configuration folders
.vscode/
.idea/
*.sublime-workspace

# === AI Tools ===
# Claude Code local settings (not project context)
.claude/
# Internal AI-agent context — not for a public portfolio repo
CLAUDE.md
.ai/

# === Python / Backend ('/api') ===
# Virtual environments
venv/
env/
*.venv
.venv
pip-freeze.txt

# Compiled Python files and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Python build and distribution folders
build/
dist/
*.egg-info/
*.egg

# Testing files
.pytest_cache/
.coverage
htmlcov/
api/tests/eval_results/

# === JavaScript / Frontend ('/frontend') ===
# Dependencies (VERY IMPORTANT!)
node_modules/

# Logs
npm-debug.log*
yarn-error.log

# Build output (Create React App, Vite, etc.)
# (Already covered by global 'build/' and 'dist/', but good to be explicit)
# build/
# dist/
.vite/

# === Project Specific ===

# Data files (PDFs, generated files)
# Keep README.md and scripts, ignore actual documents
data/*.pdf
data/*.txt
!data/README.md
!data/create_test_pdf.py

# ChromaDB local data (if running outside Docker)
chroma_data/