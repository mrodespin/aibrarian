# /api/.env.example
# Example environment variables for Bibliotecario-IA API
# Copy this file to .env and adjust values as needed

# ===================================
# API Configuration
# ===================================
APP_NAME=Bibliotecario-IA API
APP_VERSION=0.1.0
DEBUG=false

# ===================================
# Ollama Configuration
# ===================================
# IMPORTANTE: La URL de Ollama depende de tu modo de ejecución:
#
# MODO A - Desarrollo local (API con uvicorn, sin Docker):
#   OLLAMA_BASE_URL=http://localhost:11434
#
# MODO B - Híbrido (API en Docker, Ollama nativo en Mac para GPU):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   Ventaja: Ollama usa la GPU de Apple Silicon (Metal), ~10x más rápido
#
# MODO C - Todo en Docker (Linux/producción):
#   OLLAMA_BASE_URL=http://ollama:11434
#   Nota: También debes iniciar Ollama en Docker: docker-compose up -d ollama
#
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ===================================
# ChromaDB Configuration
# ===================================
# Desarrollo local (API fuera de Docker, ChromaDB en Docker):
#   HOST=localhost, PORT=8001 (puerto mapeado en docker-compose)
# Todo en Docker: estos valores se sobreescriben automáticamente
#   por docker-compose con el nombre de contenedor y puerto interno.
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=bibliotecario_docs

# ===================================
# Document Processing Configuration
# ===================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIRECTORY=./data

# ===================================
# RAG Configuration
# ===================================
MAX_CONTEXT_CHUNKS=4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=

# ===================================
# Notion Configuration
# ===================================
# Get your integration token at: https://www.notion.so/my-integrations
NOTION_API_KEY=
# Optional: Database ID for batch syncing
NOTION_DATABASE_ID=
