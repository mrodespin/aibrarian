# /api/.env.example
# Variables de entorno para Bibliotecario-IA API
#
# NOTA: Este archivo es para desarrollo LOCAL (scripts CLI).
# Cuando la API corre en Docker, las variables se definen en docker-compose.yml
#
# Copia este archivo a .env: cp .env.example .env

# ===================================
# API Configuration
# ===================================
APP_NAME=Bibliotecario-IA API
APP_VERSION=0.1.0
DEBUG=false

# ===================================
# Provider Selection (local dev vs. cloud deployment)
# ===================================
# "ollama" (default, local) o "groq" (cloud, gratuito, para Render)
LLM_PROVIDER=ollama
# "chromadb_local" (default, Docker) o "chroma_cloud" (gestionado, para Render)
VECTOR_DB_PROVIDER=chromadb_local

# ===================================
# Ollama Configuration
# ===================================
# Ollama corre de forma NATIVA en macOS (no en Docker)
# Esto aprovecha la aceleración GPU con Metal (~10x más rápido)
# Instalación: brew install ollama && ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ===================================
# ChromaDB Configuration
# ===================================
# ChromaDB corre en Docker: docker-compose up -d chromadb
# Puerto 8001 en host (mapeado desde puerto interno 8000)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=bibliotecario_docs

# ===================================
# Document Processing Configuration
# ===================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIRECTORY=./data

# ===================================
# RAG Configuration
# ===================================
MAX_CONTEXT_CHUNKS=4
LLM_TEMPERATURE=0.7

# ===================================
# Groq Configuration (solo si LLM_PROVIDER=groq)
# ===================================
# Consigue tu key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ===================================
# Local Embeddings Configuration (solo si LLM_PROVIDER=groq)
# ===================================
# Groq no ofrece endpoint de embeddings; se generan localmente en CPU
# con sentence-transformers. No requiere API key.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ===================================
# Chroma Cloud Configuration (solo si VECTOR_DB_PROVIDER=chroma_cloud)
# ===================================
# Crea tu base de datos gratuita en: https://www.trychroma.com
# tenant/database se pueden dejar vacíos: se resuelven desde la API key
# si esta está ligada a una única base de datos.
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=

# ===================================
# Notion Configuration (Opcional)
# ===================================
# Crea tu integración en: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=
