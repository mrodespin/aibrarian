# /api/.env.example
# Environment variables for the AIbrarian API
#
# NOTE: this file is for LOCAL development (CLI scripts).
# When the API runs in Docker, the variables are defined in docker-compose.yml
#
# Copy this file to .env: cp .env.example .env

# ===================================
# API Configuration
# ===================================
APP_NAME=AIbrarian API
APP_VERSION=0.1.0
DEBUG=false

# ===================================
# Provider Selection (local dev vs. cloud deployment)
# ===================================
# "ollama" (default, local) or "groq" (cloud, free, for Render)
LLM_PROVIDER=ollama
# "chromadb_local" (default, Docker) or "chroma_cloud" (managed, for Render)
VECTOR_DB_PROVIDER=chromadb_local

# ===================================
# Ollama Configuration
# ===================================
# Ollama runs NATIVELY on macOS (not in Docker)
# This takes advantage of the Metal GPU acceleration (~10x faster)
# Installation: brew install ollama && ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ===================================
# ChromaDB Configuration
# ===================================
# ChromaDB runs in Docker: docker-compose up -d chromadb
# Port 8001 on the host (mapped from internal port 8000)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=bibliotecario_docs

# ===================================
# Document Processing Configuration
# ===================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIRECTORY=./data

# ===================================
# RAG Configuration
# ===================================
MAX_CONTEXT_CHUNKS=4
LLM_TEMPERATURE=0.7

# ===================================
# Groq Configuration (only if LLM_PROVIDER=groq)
# ===================================
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ===================================
# Local Embeddings Configuration (only if LLM_PROVIDER=groq)
# ===================================
# Groq doesn't offer an embeddings endpoint; embeddings are generated
# locally on CPU with sentence-transformers. No API key required.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ===================================
# Chroma Cloud Configuration (only if VECTOR_DB_PROVIDER=chroma_cloud)
# ===================================
# Create your free database at: https://www.trychroma.com
# tenant/database can be left empty: they're resolved from the API key
# if it's bound to a single database.
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=

# ===================================
# Notion Configuration (Optional)
# ===================================
# Create your integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===================================
# Authentication Configuration
# ===================================
# Local Postgres (docker-compose up -d postgres). If you run the API INSIDE
# Docker, docker-compose.yml overrides this with the service's hostname
# ("postgres" instead of "localhost") — no need to change it yourself.
DATABASE_URL=postgresql://bibliotecario:bibliotecario@localhost:5432/bibliotecario
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-random-secret
JWT_EXPIRATION_MINUTES=1440
# The frontend's exact origin in dev (Vite). Used for CORS.
FRONTEND_URL=http://localhost:5173
